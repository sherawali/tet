{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tet.local/schemas/asset.schema.json",
  "title": "Checksummed media asset",
  "type": "object",
  "required": ["schemaVersion", "id", "type", "files", "alt", "status"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "common.schema.json#/$defs/stableId"},
    "type": {"enum": ["svg", "webp", "png", "jpeg", "audio"]},
    "files": {
      "type": "object",
      "properties": {
        "neutral": {"$ref": "#/$defs/file"},
        "hi": {"$ref": "#/$defs/file"},
        "en": {"$ref": "#/$defs/file"},
        "sa": {"$ref": "#/$defs/file"},
        "ur": {"$ref": "#/$defs/file"}
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "alt": {"$ref": "common.schema.json#/$defs/localizedText"},
    "status": {"enum": ["draft", "published", "retired"]}
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
