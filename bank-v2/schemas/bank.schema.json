{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tet.local/schemas/bank.schema.json",
  "title": "TET V2 bank configuration",
  "type": "object",
  "required": ["schemaVersion", "bankVersion", "databaseId", "status", "exams", "sync"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"type": "integer", "minimum": 1},
    "bankVersion": {"type": "integer", "minimum": 0},
    "databaseId": {"type": "string", "minLength": 3},
    "status": {"enum": ["structure-only", "migrating", "active", "retired"]},
    "contentFormat": {"const": "ndjson"},
    "defaultLocale": {"$ref": "common.schema.json#/$defs/locale"},
    "supportedLocales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/locale"}
    },
    "exams": {"type": "object", "required": ["ctet", "utet"]},
    "sync": {
      "type": "object",
      "required": ["direction", "loginRequired", "offlineFirst", "contentDatabase", "userDatabase"],
      "properties": {
        "direction": {"const": "remote-to-device"},
        "loginRequired": {"const": false},
        "offlineFirst": {"const": true},
        "contentDatabase": {"const": "content.sqlite"},
        "userDatabase": {"const": "user.sqlite"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
