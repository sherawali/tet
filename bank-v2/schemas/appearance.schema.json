{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tet.local/schemas/appearance.schema.json",
  "title": "One verified question occurrence in a real paper",
  "type": "object",
  "required": [
    "schemaVersion", "id", "questionId", "paperFormId", "exam", "paper",
    "examDate", "section", "questionNumber", "verificationStatus"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "common.schema.json#/$defs/stableId"},
    "questionId": {"$ref": "common.schema.json#/$defs/stableId"},
    "paperFormId": {"$ref": "common.schema.json#/$defs/stableId"},
    "exam": {"$ref": "common.schema.json#/$defs/exam"},
    "paper": {"$ref": "common.schema.json#/$defs/paper"},
    "examDate": {"type": "string", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])(-[0-3][0-9])?$"},
    "shift": {"type": ["integer", "null"], "minimum": 1},
    "setCode": {"type": ["string", "null"]},
    "section": {"$ref": "common.schema.json#/$defs/section"},
    "language": {"type": ["string", "null"], "enum": ["hi", "en", "sa", "ur", null]},
    "languageSlot": {"type": ["integer", "null"], "enum": [1, 2, null]},
    "questionNumber": {"type": "integer", "minimum": 1},
    "officialOptionId": {"type": ["string", "null"]},
    "sourceRef": {"type": ["string", "null"]},
    "verificationStatus": {"enum": ["unverified", "provisional", "verified"]}
  },
  "additionalProperties": false
}
