{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tet.local/schemas/common.schema.json",
  "title": "TET V2 common definitions",
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "exam": {"enum": ["ctet", "utet"]},
    "paper": {"enum": [1, 2]},
    "locale": {"enum": ["hi", "en", "sa", "ur"]},
    "section": {
      "enum": [
        "cdp", "language", "mathematics", "environmental-studies",
        "science", "social-studies"
      ]
    },
    "localizedText": {
      "type": "object",
      "properties": {
        "hi": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1},
        "sa": {"type": "string", "minLength": 1},
        "ur": {"type": "string", "minLength": 1}
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "contentBlock": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "text"],
          "properties": {
            "kind": {"const": "markdown"},
            "text": {"$ref": "#/$defs/localizedText"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "latex"],
          "properties": {
            "kind": {"const": "math"},
            "latex": {"type": "string", "minLength": 1},
            "fallback": {"$ref": "#/$defs/localizedText"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "assetId"],
          "properties": {
            "kind": {"enum": ["image", "audio"]},
            "assetId": {"$ref": "#/$defs/stableId"},
            "caption": {"$ref": "#/$defs/localizedText"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "columns", "rows"],
          "properties": {
            "kind": {"const": "table"},
            "caption": {"$ref": "#/$defs/localizedText"},
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "header"],
                "properties": {
                  "id": {"$ref": "#/$defs/stableId"},
                  "header": {"$ref": "#/$defs/localizedText"}
                },
                "additionalProperties": false
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["cells"],
                "properties": {
                  "cells": {
                    "type": "object",
                    "additionalProperties": {"$ref": "#/$defs/localizedText"}
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "contentBlocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contentBlock"}
    },
    "option": {
      "type": "object",
      "required": ["id", "content"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+$"},
        "content": {"$ref": "#/$defs/contentBlocks"}
      },
      "additionalProperties": false
    }
  }
}
